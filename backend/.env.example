# ── Application ───────────────────────────────────────────────
APP_NAME=TeachBack
ENV=development
# Comma-separated list of allowed CORS origins (the frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ──────────────────────────────────────────────────
# SQLite by default (zero setup). Swap for a Postgres URL to scale:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/teachback
DATABASE_URL=sqlite:///./teachback.db

# ── LLM provider ──────────────────────────────────────────────
# LLM_PROVIDER selects the adapter: "sarvam" (real) or "mock" (offline, deterministic).
# Leave as "mock" to run the full demo with NO API keys.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=sarvam-m
LLM_BASE_URL=https://api.sarvam.ai

# ── Speech-to-text provider ───────────────────────────────────
STT_PROVIDER=mock
STT_API_KEY=
STT_MODEL=saarika:v2

# ── Embeddings / retrieval ────────────────────────────────────
EMBEDDING_PROVIDER=mock
RETRIEVER_BACKEND=local
# Only needed if RETRIEVER_BACKEND=qdrant (not required for the MVP demo)
QDRANT_URL=
QDRANT_API_KEY=
